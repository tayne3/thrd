#ifndef THRD_CONFIG_WIN32_H
#define THRD_CONFIG_WIN32_H

#cmakedefine THRD_USE_NATIVE
#cmakedefine THRD_SUPPORT_NATIVE
#cmakedefine THRD_HAVE_TIMESPEC
#cmakedefine THRD_HAVE_TIMESPEC_GET

#ifdef __cplusplus
extern "C" {
#endif

typedef struct {
	void         *handle;
	unsigned long id;
} thrd_t;

typedef void         *mtx_t;
typedef void         *cnd_t;
typedef unsigned long tss_t;

typedef struct {
	void *Ptr;
} once_flag;

#define ONCE_FLAG_INIT      {0}
#define TSS_DTOR_ITERATIONS 4

#ifdef _MSC_VER
#ifndef _UCRT
#ifndef THRD_HAVE_TIMESPEC
#ifdef _USE_32BIT_TIME_T
struct timespec {
	long tv_sec;
	long tv_nsec;
};
#else
struct timespec {
	long long tv_sec;
	long      tv_nsec;
};
#endif
#endif  // THRD_HAVE_TIMESPEC
#endif  // _UCRT
#else
#ifndef THRD_HAVE_TIMESPEC
struct timespec {
	long tv_sec;
	long tv_nsec;
};
#endif
#endif

#ifdef __cplusplus
}
#endif
#endif  // THRD_CONFIG_WIN32_H
